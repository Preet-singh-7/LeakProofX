# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/leakproofx

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=20m
JWT_REFRESH_TTL=7d

# QR token signing (independent from auth secrets)
QR_SIGNING_SECRET=change-me-qr-secret-min-32-chars-long

# Encryption
# Paper content is encrypted with AES-256-GCM using a key referenced by keyId.
# Each keyId below maps to a base64-encoded 32-byte key. Never commit real keys.
# Format: PAPER_ENC_KEY_<KEYID>=base64key
PAPER_ENC_KEY_v1=CHANGE_ME_BASE64_32_BYTE_KEY==
ACTIVE_PAPER_KEY_ID=v1

# Time-lock windows (minutes)
ALLOWED_PRE_WINDOW_MINUTES=30
ALLOWED_POST_WINDOW_MINUTES=180

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006

# Seed admin (used by scripts/seedAdmin.js)
SEED_ADMIN_EMAIL=admin@leakproofx.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=System Admin

# Logging
LOG_LEVEL=info
